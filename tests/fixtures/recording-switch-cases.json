{
 "contract": "EARS-387 recording switch contract, rules 1-11",
 "notes": [
  "file: 'absent' = no file at the path; 'unreadable' = exists, mode 000; 'invalid-json' = the bytes '{not json'; {raw} = the exact file text",
  "env_*: null = unset; a string = the exact value, whitespace included",
  "cli: null = no flag; true = --record; false = --no-record",
  "record_days.invalid is not asserted: an invalid days layer is skipped (rule 5), so the winning layer is valid by construction; report a warning",
  "record.invalid=true means a layer held an invalid value and won with OFF (rule 4)",
  "record_notice (rule 10): an invalid value FAILS TO ON, so on=true, invalid=true, and the invalid layer wins",
  "record_spoken_notice (rule 11): resolves exactly like record_notice, independently of it; an invalid value fails to ON"
 ],
 "cases": [
  {
   "name": "all unset -> default off",
   "input": {
    "cli": null,
    "env_EARS_RECORD": null,
    "env_EARS_RECORD_DAYS": null,
    "file": "absent",
    "env_EARS_RECORD_NOTICE": null,
    "env_EARS_RECORD_SPOKEN_NOTICE": null
   },
   "expect": {
    "record": {
     "on": false,
     "source": "default",
     "invalid": false
    },
    "record_days": {
     "value": 7,
     "source": "default",
     "invalid": false
    },
    "record_notice": {
     "on": true,
     "source": "default",
     "invalid": false
    },
    "record_spoken_notice": {
     "on": true,
     "source": "default",
     "invalid": false
    }
   }
  },
