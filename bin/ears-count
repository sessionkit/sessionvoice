#!/usr/bin/env bash
# bin/ears-count - the plugin's door to ears-count (how many heard-first waiters are up
# for a seat), on the Bash tool's PATH while the plugin is enabled (Claude Code:
# "Executables | bin/ | added to the Bash tool's PATH"). Finds the script from its own
# location and execs it: the one implementation stays in
# skills/ears/scripts/ears-count, never copied here, and that path still works.
set -euo pipefail
here="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)"
root="$(cd "$here/.." && pwd)"
exec "$root/skills/ears/scripts/ears-count" "$@"
