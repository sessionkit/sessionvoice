#!/usr/bin/env bash
# bin/ears-arm - the plugin's door to ears-arm (arm the ONE heard-first waiter for a
# seat), on the Bash tool's PATH while the plugin is enabled (Claude Code: "Executables
# | bin/ | added to the Bash tool's PATH"). Finds the script from its own location and
# execs it: the one implementation stays in skills/ears/scripts/ears-arm, never copied
# here, and that path still works. exec keeps $0 the script's own path, so its lookup
# of ears-count beside it is unchanged.
set -euo pipefail
here="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)"
root="$(cd "$here/.." && pwd)"
exec "$root/skills/ears/scripts/ears-arm" "$@"
