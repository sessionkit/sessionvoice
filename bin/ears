#!/usr/bin/env bash
# bin/ears - the plugin's copy of the verb, on the Bash tool's PATH while the plugin is
# enabled (Claude Code: "Executables | bin/ | added to the Bash tool's PATH"). Finds
# the package from its own location; needs only uv, which builds the package's venv
# (with the capture extras) on first use and reuses it after. Same pattern as the
# deltachat plugin's bin/deltachat.
set -euo pipefail
here="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)"
root="$(cd "$here/.." && pwd)"
command -v uv >/dev/null 2>&1 || { echo "ears: uv is not on the PATH - install it: https://docs.astral.sh/uv/" >&2; exit 2; }
exec uv run --quiet --project "$root" --extra capture ears "$@"
